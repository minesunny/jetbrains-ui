{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "demo-idea-window",
  "type": "registry:ui",
  "title": "IDEA Window Demo",
  "description": "Demo showing IDEA window layout with real project tree, code editor, and operation log",
  "dependencies": ["ace-builds"],
  "registryDependencies": [
    "@jetbrains-ui/idea-window",
    "@jetbrains-ui/dynamic-tree",
    "@jetbrains-ui/code-editor"
  ],
  "files": [
    {
      "path": "registry/demo/components/idea-window/index.tsx",
      "type": "registry:ui",
      "target": "components/jetbrains-ui/demo/idea-window.tsx"
    },
    {
      "path": "registry/demo/components/idea-window/project-data.ts",
      "type": "registry:ui",
      "target": "components/jetbrains-ui/demo/idea-window-project-data.ts"
    }
  ],
  "meta": {
    "demoProps": {
      "IdeaWindowDemo": {
        "autoSaveId": {
          "value": "idea-window-demo"
        },
        "collapsible": {
          "value": true
        }
      }
    }
  }
}
