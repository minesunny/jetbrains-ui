{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dialog",
  "type": "registry:ui",
  "title": "Dialog",
  "description": "JetBrains-style modal dialog built on Radix Dialog with themed header and footer.",
  "dependencies": [
    "radix-ui"
  ],
  "registryDependencies": [],
  "files": [
    {
      "path": "registry/components/dialog/index.tsx",
      "type": "registry:ui",
      "target": "components/jetbrains-ui/dialog.tsx"
    }
  ],
  "meta": {
    "keywords": [
      "dialog",
      "modal",
      "jetbrains",
      "ui",
      "component"
    ],
    "category": "overlay",
    "docs": {
      "description": "JetBrains-style dialog component for modal interactions.",
      "features": [
        "Built on Radix Dialog",
        "Themed header with border-bottom separator",
        "Themed footer with border-top separator",
        "Token-driven light/dark theme support",
        "Keyboard and screen-reader accessible",
        "Composable header/content/footer API"
      ]
    }
  }
}
