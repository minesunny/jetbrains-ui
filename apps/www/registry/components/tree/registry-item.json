{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "trees",
  "type": "registry:ui",
  "title": "Trees",
  "description": "JetBrains-style tree view components including static tree and dynamic async tree.",
  "dependencies": ["@headless-tree/core", "@headless-tree/react"],
  "registryDependencies": [
    "scroll-area",
    "context-menu",
    "icons-general-general-delete",
    "icons-general-general-chevron-down",
    "icons-general-general-chevron-right",
    "icons-general-spinner-loader"
  ],
  "files": [
    {
      "path": "registry/components/tree/tree/index.tsx",
      "type": "registry:ui",
      "target": "components/jetbrains-ui/tree/tree.tsx"
    },
    {
      "path": "registry/components/tree/dynamic-tree/index.tsx",
      "type": "registry:ui",
      "target": "components/jetbrains-ui/tree/dynamic-tree.tsx"
    },
    {
      "path": "registry/components/tree/dynamic-tree/feature.ts",
      "type": "registry:lib",
      "target": "components/jetbrains-ui/tree/dynamic-tree/feature.ts"
    }
  ],
  "meta": {
    "keywords": ["tree", "navigation", "jetbrains", "ui", "component"],
    "category": "navigation",
    "docs": {
      "description": "JetBrains-style tree view components including static tree and dynamic async tree.",
      "features": [
        "Static nested tree structure",
        "Dynamic async tree with data loading",
        "Controlled and uncontrolled selected/expanded states",
        "Keyboard support for selection and collapse",
        "Token-driven light/dark theme support"
      ]
    }
  }
}
