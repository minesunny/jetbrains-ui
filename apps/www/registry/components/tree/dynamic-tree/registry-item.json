{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "dynamic-tree",
  "type": "registry:ui",
  "title": "Dynamic Tree",
  "description": "Async tree component built on top of @headless-tree with JetBrains UI styling.",
  "dependencies": ["@headless-tree/core", "@headless-tree/react"],
  "registryDependencies": [
    "scroll-area",
    "context-menu",
    "icons-general-general-add",
    "icons-general-general-delete",
    "icons-general-general-refresh",
    "icons-general-general-remove",
    "icons-general-general-chevron-down",
    "icons-general-general-chevron-right",
    "icons-general-spinner-loader"
  ],
  "files": [
    {
      "path": "registry/components/tree/dynamic-tree/index.tsx",
      "type": "registry:ui",
      "target": "components/jetbrains-ui/tree/dynamic-tree.tsx"
    },
    {
      "path": "registry/components/tree/dynamic-tree/feature.ts",
      "type": "registry:lib",
      "target": "components/jetbrains-ui/tree/dynamic-tree/feature.ts"
    }
  ],
  "meta": {
    "keywords": [
      "tree",
      "dynamic",
      "async",
      "navigation",
      "jetbrains",
      "ui",
      "component"
    ],
    "category": "navigation",
    "docs": {
      "description": "Async tree component built on top of @headless-tree.",
      "features": [
        "Async data loading with caching",
        "Customizable item component",
        "Built-in context menu support",
        "Token-driven light/dark theme support"
      ]
    }
  }
}
